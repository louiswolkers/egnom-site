---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import { siteInfo } from '../data/siteContent';

interface Props {
	title: string;
	description: string;
	/** share image: path from the site root (file in public/) or full URL; 1200x630 works best */
	image?: string;
	/** false on pages without an address of their own, such as the error page */
	isIndexable?: boolean;
}

const { title, description, image, isIndexable = true } = Astro.props;

const basePath = import.meta.env.BASE_URL;
// the page address needs the public domain, which only exists in the published build
const pageUrl = isIndexable && Astro.site && new URL(Astro.url.pathname, Astro.site).href;
// share images must be absolute; without a public domain, the current address is the base
const imageUrl = new URL(image || `${basePath}social-card.png`, Astro.site ?? Astro.url).href;
// size is only known for the default card
const isDefaultImage = !image;
const imageAlt = isDefaultImage ? 'Egnom, o monge robô' : title;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0a0908" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href={`${basePath}favicon.svg`} />
		<title>{title}</title>
		{!isIndexable && <meta name="robots" content="noindex" />}

		{pageUrl && <link rel="canonical" href={pageUrl} />}

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:site_name" content={siteInfo.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{pageUrl && <meta property="og:url" content={pageUrl} />}
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:alt" content={imageAlt} />
		{isDefaultImage && <meta property="og:image:width" content="1200" />}
		{isDefaultImage && <meta property="og:image:height" content="630" />}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<meta name="twitter:image:alt" content={imageAlt} />
	</head>
	<body class="overflow-x-hidden bg-ink font-sans text-white antialiased selection:bg-flame/40">
		<slot />
	</body>
</html>

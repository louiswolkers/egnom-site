---
import { siteInfo } from '../data/siteContent';
import Layout from '../layouts/Layout.astro';
---

<Layout title={`Página não encontrada · ${siteInfo.name}`} description={siteInfo.description} isIndexable={false}>
	<main class="flex min-h-screen flex-col items-center justify-center px-6 text-center">
		<p class="mb-4 font-mono text-xs tracking-widest text-ember uppercase">Erro 404</p>
		<h1 class="mb-4 text-4xl font-medium tracking-tight md:text-5xl">Esta página não existe</h1>
		<p class="mb-10 font-light text-sand">O monge procurou com calma e não encontrou nada aqui.</p>
		<a href={import.meta.env.BASE_URL} class="rounded-full bg-white px-8 py-3.5 text-sm font-medium text-black transition-colors hover:bg-peach">
			Voltar ao início
		</a>
	</main>
</Layout>

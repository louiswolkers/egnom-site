---
import { authorProfile, siteInfo } from '../data/siteContent';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="px-6 py-8">
	<div class="mx-auto max-w-7xl">
		<div class="flex flex-col justify-between gap-6 pb-6 md:flex-row md:items-center">
			<div>
				<p class="mb-1 text-sm text-white/55">Desenvolvido por <span class="font-medium text-white">{authorProfile.name}</span></p>
				<p class="font-mono text-xs text-white/55">{authorProfile.headline}</p>
			</div>
			<ul class="flex flex-wrap gap-3">
				{authorProfile.links.map((link) => (
					<li>
						<a class="inline-flex items-center gap-2 rounded-full border border-edge px-4 py-2 text-sm text-white/70 transition-colors hover:border-ember hover:text-white" href={link.href} target="_blank" rel="me noopener noreferrer">
							<Icon name={link.icon} size={16} />
							{link.label}
							<span class="sr-only">(abre em nova aba)</span>
						</a>
					</li>
				))}
			</ul>
		</div>
		<p class="border-t border-white/5 pt-6 text-xs text-white/55">© {year} {siteInfo.name}</p>
	</div>
</footer>

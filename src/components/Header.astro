---
import { navLinks, siteInfo } from '../data/siteContent';
import Icon from './Icon.astro';
---

<header class="fixed top-0 z-50 w-full border-b border-white/5 bg-ink/60 backdrop-blur-xl">
	<nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6">
		<a href="#top" class="group flex items-center gap-3">
			<span class="flex size-8 items-center justify-center rounded-lg border border-ember/30 bg-ember/10 transition-colors group-hover:border-gold/60">
				<Icon name="lucide:orbit" class="text-peach" />
			</span>
			<span class="text-sm font-medium tracking-[0.35em] text-white/90">{siteInfo.name}</span>
		</a>

		<ul class="hidden items-center gap-6 md:flex lg:gap-8">
			{navLinks.map((link) => (
				<li>
					<a class="text-xs font-medium text-white/60 transition-colors hover:text-white" href={link.href}>{link.label}</a>
				</li>
			))}
		</ul>

		<div class="flex items-center gap-3">
			<a href="#como-funciona" class="group flex items-center gap-1 rounded-full bg-white px-4 py-2 text-xs font-medium text-black transition-colors hover:bg-peach">
				Conhecer
				<Icon name="lucide:arrow-right" size={12} class="transition-transform group-hover:translate-x-0.5" />
			</a>

			<details id="mobile-menu" class="md:hidden">
				<summary class="flex cursor-pointer list-none text-white/80 [&::-webkit-details-marker]:hidden" aria-label="Abrir menu">
					<Icon name="lucide:menu" size={22} />
				</summary>
				<ul class="absolute top-16 right-0 left-0 border-b border-edge bg-ink px-6 py-3">
					{navLinks.map((link) => (
						<li><a class="block py-3 text-sm text-white/70" href={link.href}>{link.label}</a></li>
					))}
				</ul>
			</details>
		</div>
	</nav>
</header>

<script>
	const mobileMenu = document.querySelector<HTMLDetailsElement>('#mobile-menu');
	mobileMenu?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => mobileMenu.removeAttribute('open'));
	});
</script>

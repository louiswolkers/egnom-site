---
import Icon from './Icon.astro';
---

<section class="relative bg-gradient-to-b from-ink to-flame/10 px-6 py-32 text-center">
	<h2 class="mb-8 text-5xl font-medium tracking-tight md:text-6xl">
		Respire.{' '}
		<span class="bg-gradient-to-b from-peach to-ember/70 bg-clip-text text-transparent">O monge cuida.</span>
	</h2>
	<p class="mb-10 text-xl font-light text-sand">Este é só o começo da história do Egnom.</p>
	<a href="#top" class="inline-flex items-center gap-2 rounded-full bg-white px-8 py-3.5 text-sm font-medium text-black transition-colors hover:bg-peach">
		Voltar ao início
		<Icon name="lucide:arrow-up" />
	</a>
	<div class="absolute right-0 bottom-0 left-0 h-px bg-gradient-to-r from-transparent via-ember/60 to-transparent"></div>
</section>

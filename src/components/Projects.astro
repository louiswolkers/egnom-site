---
import { projects } from '../data/projects';
import Icon from './Icon.astro';
---

<section id="projetos" class="border-t border-white/5 px-6 py-24">
	<div class="mx-auto max-w-7xl">
		<p class="mb-2 font-mono text-xs tracking-widest text-ember uppercase">Feitos com ajuda de IA</p>
		<h2 class="mb-12 text-4xl font-medium tracking-tight md:text-5xl">Projetos</h2>

		<ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
			{projects.map((project) => (
				<li class:list={['flex', project.isWide && 'lg:col-span-2']}>
					<article class="glass-panel group flex w-full flex-col overflow-hidden rounded-3xl transition-colors duration-500 hover:border-ember/50">
						<div class="relative flex h-36 items-center justify-center overflow-hidden border-b border-white/5 bg-[radial-gradient(circle_at_50%_120%,rgb(232_112_10/0.35),transparent_70%)]" aria-hidden="true">
							<span class="absolute size-24 rounded-full border border-ember/25"></span>
							<span class="absolute size-40 rounded-full border border-ember/15"></span>
							<span class="relative flex size-14 items-center justify-center rounded-2xl border border-ember/30 bg-ink text-peach transition-transform duration-500 group-hover:scale-110">
								<Icon name={project.icon} size={26} />
							</span>
						</div>

						<div class="flex grow flex-col p-8">
							<div class="mb-3 flex flex-wrap items-center justify-between gap-3">
								<h3 class="text-xl font-medium">{project.name}</h3>
								{project.status && (
									<span class="rounded-full border border-edge px-2.5 py-1 font-mono text-[10px] text-gold">{project.status}</span>
								)}
							</div>
							<p class="mb-3 text-sm leading-relaxed text-sand">{project.summary}</p>
							<p class="mb-6 text-sm leading-relaxed text-white/55">{project.highlight}</p>
							<ul class="mt-auto flex flex-wrap gap-2 border-t border-white/5 pt-4" aria-label="Tecnologias">
								{project.stack.map((technology) => (
									<li class="rounded bg-white/5 px-2 py-1 font-mono text-[11px] text-white/70">{technology}</li>
								))}
							</ul>
							{project.link && (
								<a href={project.link} class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-peach hover:text-gold">
									Ver o projeto {project.name}
									<Icon name="lucide:arrow-up-right" size={14} />
								</a>
							)}
						</div>
					</article>
				</li>
			))}
		</ul>
	</div>
</section>

---
import { integrations } from '../data/siteContent';
import Icon from './Icon.astro';
---

<section class="border-y border-white/5 bg-white/[0.01] px-6 py-20 text-center">
	<h2 class="mb-4 text-3xl tracking-tight">Do que ele é feito</h2>
	<p class="mb-16 font-light text-sand">Ferramentas conhecidas, trabalhando juntas.</p>
	<ul class="mx-auto flex max-w-5xl flex-wrap items-start justify-center gap-12 md:gap-16">
		{integrations.map((integration, index) => (
			<li class="flex flex-col items-center gap-3">
				<span class="animate-glow text-peach" style={`animation-delay: ${(index % 4) * 0.9}s`}>
					<Icon name={integration.icon} size={32} />
				</span>
				<span class="text-xs text-white/50">{integration.name}</span>
			</li>
		))}
	</ul>
</section>

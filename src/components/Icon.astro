---
import lucide from '@iconify-json/lucide/icons.json';
import simple from '@iconify-json/simple-icons/icons.json';

interface Props {
	/** "lucide:name" or "simple:name" */
	name: string;
	size?: number;
	class?: string;
}

const { name, size = 18, class: className } = Astro.props;
const [prefix, iconName] = name.split(':');
const set = prefix === 'simple' ? simple : lucide;

type IconSet = {
	icons: Record<string, { body: string }>;
	aliases?: Record<string, { parent: string }>;
};
const { icons, aliases } = set as IconSet;
const icon = icons[iconName] ?? icons[aliases?.[iconName]?.parent ?? ''];

if (!icon) throw new Error(`Icon not found: ${name}`);
---

<svg class={className} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" set:html={icon.body} />
